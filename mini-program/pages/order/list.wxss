/* 订单列表页 */
.order-page {
  min-height: 100vh;
  background: #F5F6F8;
  padding: 20rpx;
}

.login-tip,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.login-btn,
.order-btn {
  margin-top: 40rpx;
}

.order-list {
  padding-bottom: 40rpx;
}

.order-card {
  background: #262626;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #333;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #333;
}

.order-no {
  font-size: 24rpx;
  color: #6B7280;
}

.order-body {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.label {
  font-size: 26rpx;
  color: #6B7280;
}

.value {
  font-size: 26rpx;
  color: #f0f0f0;
}

.amount {
  color: #f0f0f0;
}

.discount {
  color: #4caf50;
}

.pay-amount {
  color: #7C9A92;
  font-weight: bold;
  font-size: 30rpx;
}

.time {
  font-size: 24rpx;
  color: #666;
}

.order-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #333;
}

.load-more {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #666;
  font-size: 24rpx;
}
