/* ============================================
   生日礼品页样式
   ============================================ */

.page-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx 30rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #7C9A92;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #6B7280;
}

/* 生日卡片 */
.birthday-section {
  padding: 0 30rpx;
}

.birthday-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(124, 154, 146, 0.15);
}

.birthday-card.celebrate {
  border: 2rpx solid rgba(124, 154, 146, 0.4);
  animation: pulse-gold 2s ease-in-out infinite;
}

@keyframes pulse-gold {
  0%, 100% { box-shadow: 0 0 10rpx rgba(124, 154, 146, 0.1); }
  50% { box-shadow: 0 0 40rpx rgba(124, 154, 146, 0.3); }
}

.birthday-animation {
  margin-bottom: 20rpx;
}

.birthday-emoji {
  font-size: 60rpx;
}

.birthday-calendar {
  margin-bottom: 20rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(124, 154, 146, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.birthday-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1D23;
  margin-bottom: 12rpx;
}

.birthday-desc {
  font-size: 26rpx;
  color: #6B7280;
  text-align: center;
  margin-bottom: 30rpx;
  line-height: 1.5;
}

/* 礼品项 */
.gift-item {
  display: flex;
  align-items: center;
  background: rgba(124, 154, 146, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  width: 100%;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
}

.gift-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(124, 154, 146, 0.2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.gift-detail {
  flex: 1;
}

.gift-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D23;
  display: block;
  margin-bottom: 4rpx;
}

.gift-value {
  font-size: 26rpx;
  color: #7C9A92;
}

.claim-btn {
  width: 100%;
}

/* 礼品预览 */
.gift-preview {
  width: 100%;
  background: rgba(124, 154, 146, 0.05);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.preview-title {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
  display: block;
}

.preview-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #1A1D23;
}

.set-btn {
  width: 100%;
}

/* 日期选择器 */
.date-picker-section {
  width: 100%;
  margin-top: 10rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
  background: #FFFFFF;
}

/* 历史记录 */
.history-section {
  padding: 30rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #7C9A92;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #7C9A92;
}

.history-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.history-item:last-child {
  border-bottom: none;
}

.history-info {
  display: flex;
  flex-direction: column;
}

.history-name {
  font-size: 28rpx;
  color: #1A1D23;
  margin-bottom: 4rpx;
}

.history-year {
  font-size: 24rpx;
  color: #6B7280;
}

.history-status {
  font-size: 24rpx;
  color: #6B7280;
  padding: 6rpx 16rpx;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 10rpx;
}

.history-status.claimed {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.2);
}
