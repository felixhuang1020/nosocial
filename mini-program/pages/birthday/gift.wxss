/* ============================================
   生日礼品页样式
   ============================================ */

.page-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx 30rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #7C9A92;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #6B7280;
}

/* 生日卡片 */
.birthday-section {
  padding: 0 30rpx;
}

.birthday-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(124, 154, 146, 0.15);
}

.birthday-card.celebrate {
  border: 2rpx solid rgba(124, 154, 146, 0.4);
  animation: pulse-gold 2s ease-in-out infinite;
}

@keyframes pulse-gold {
  0%, 100% { box-shadow: 0 0 10rpx rgba(124, 154, 146, 0.1); }
  50% { box-shadow: 0 0 40rpx rgba(124, 154, 146, 0.3); }
}

.birthday-animation {
  margin-bottom: 20rpx;
}

.birthday-emoji {
  font-size: 60rpx;
}

.birthday-calendar {
  margin-bottom: 20rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(124, 154, 146, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.birthday-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1D23;
  margin-bottom: 12rpx;
}

/* 生日月日展示 */
.birthday-title-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.birthday-title-label {
  font-size: 28rpx;
  color: #6B7280;
  letter-spacing: 2rpx;
}

.birthday-date-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, rgba(124, 154, 146, 0.14) 0%, rgba(95, 133, 120, 0.08) 100%);
  border: 1rpx solid rgba(124, 154, 146, 0.25);
  box-shadow: 0 4rpx 12rpx rgba(124, 154, 146, 0.1);
}

.birthday-date-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #5F8578;
  line-height: 1;
  font-feature-settings: 'tnum';
  letter-spacing: 2rpx;
}

.birthday-date-sep {
  font-size: 32rpx;
  color: rgba(124, 154, 146, 0.6);
  line-height: 1;
  transform: translateY(-2rpx);
}

.birthday-desc {
  font-size: 26rpx;
  color: #6B7280;
  text-align: center;
  margin-bottom: 30rpx;
  line-height: 1.5;
}

/* 礼品项 */
.gift-item {
  display: flex;
  align-items: center;
  background: rgba(124, 154, 146, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  width: 100%;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
}

.gift-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(124, 154, 146, 0.2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.gift-detail {
  flex: 1;
}

.gift-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D23;
  display: block;
  margin-bottom: 4rpx;
}

.gift-value {
  font-size: 26rpx;
  color: #7C9A92;
}

.claim-btn {
  width: 100%;
}

/* 神秘礼品 */
.gift-preview {
  width: 100%;
  position: relative;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, rgba(124, 154, 146, 0.12) 0%, rgba(95, 133, 120, 0.08) 100%);
  border: 2rpx dashed rgba(124, 154, 146, 0.35);
  overflow: hidden;
}

.gift-preview::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 140rpx;
  height: 140rpx;
  background: radial-gradient(circle, rgba(124, 154, 146, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.gift-preview::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: -30rpx;
  width: 100rpx;
  height: 100rpx;
  background: radial-gradient(circle, rgba(124, 154, 146, 0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.mystery-gift-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #7C9A92;
}

.mystery-gift-box {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #7C9A92 0%, #5F8578 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  position: relative;
  z-index: 1;
  box-shadow:
    0 8rpx 24rpx rgba(95, 133, 120, 0.25),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.15);
}

.mystery-gift-icon {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  animation: mystery-pulse 2.5s ease-in-out infinite;
  backdrop-filter: blur(4rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
}

@keyframes mystery-pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 0 rgba(255, 255, 255, 0);
  }
  50% {
    transform: scale(1.08);
    box-shadow: 0 0 20rpx rgba(255, 255, 255, 0.25);
  }
}

.mystery-gift-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.mystery-gift-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.mystery-gift-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.mystery-gift-decorations {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 20rpx;
  position: relative;
  z-index: 1;
}

.deco-dot {
  width: 8rpx;
  height: 8rpx;
  background: rgba(124, 154, 146, 0.5);
  border-radius: 50%;
  animation: dot-float 2s ease-in-out infinite;
}

.deco-dot:nth-child(2) {
  animation-delay: 0.3s;
}

.deco-dot:nth-child(3) {
  animation-delay: 0.6s;
}

@keyframes dot-float {
  0%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  50% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

.set-btn {
  width: 100%;
}

/* 日期选择器 */
.date-picker-section {
  width: 100%;
  margin-top: 10rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
  background: #FFFFFF;
}

/* 历史记录 */
.history-section {
  padding: 30rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #7C9A92;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #7C9A92;
}

.history-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.history-item:last-child {
  border-bottom: none;
}

.history-info {
  display: flex;
  flex-direction: column;
}

.history-name {
  font-size: 28rpx;
  color: #1A1D23;
  margin-bottom: 4rpx;
}

.history-year {
  font-size: 24rpx;
  color: #6B7280;
}

.history-status {
  font-size: 24rpx;
  color: #6B7280;
  padding: 6rpx 16rpx;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 10rpx;
}

.history-status.claimed {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.2);
}
