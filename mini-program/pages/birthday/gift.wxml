<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <t-icon name="gift" size="64rpx" color="#7C9A92" />
    <text class="page-title">生日有礼</text>
    <text class="page-subtitle">股东专属生日福利</text>
  </view>
  
  <!-- 生日状态 -->
  <view class="birthday-section">
    <!-- 今天是生日 -->
    <block wx:if="{{isBirthday}}">
      <view class="birthday-card celebrate">
        <view class="birthday-animation">
          <text class="birthday-emoji">🎂 🎉 🎁</text>
        </view>
        <text class="birthday-title">生日快乐！</text>
        <text class="birthday-desc">今天是你的生日，我们为你准备了专属礼品</text>
        
        <view class="gift-item" wx:if="{{giftInfo}}">
          <view class="gift-icon">
            <t-icon name="wine" size="48rpx" color="#7C9A92" />
          </view>
          <view class="gift-detail">
            <text class="gift-name">{{giftInfo.gift_name}}</text>
            <text class="gift-value">价值 ¥{{giftInfo.gift_value}}</text>
          </view>
        </view>
        
        <t-button 
          theme="primary" 
          class="btn-gold claim-btn" 
          size="large"
          bindtap="claimGift"
          loading="{{claiming}}"
          disabled="{{giftClaimed}}"
        >
          {{giftClaimed ? '已领取' : '立即领取'}}
        </t-button>
      </view>
    </block>
    
    <!-- 不是今天 -->
    <block wx:if="{{!isBirthday}}">
      <view class="birthday-card">
        <view class="birthday-calendar">
          <t-icon name="calendar" size="80rpx" color="#7C9A92" />
        </view>
        <view class="birthday-title-row" wx:if="{{birthday}}">
          <text class="birthday-title-label">你的生日是</text>
          <view class="birthday-date-chip">
            <text class="birthday-date-num">{{birthdayMonth}}</text>
            <text class="birthday-date-sep">•</text>
            <text class="birthday-date-num">{{birthdayDay}}</text>
          </view>
        </view>
        <text class="birthday-title" wx:if="{{!birthday}}">尚未设置生日</text>
        
        <text class="birthday-desc" wx:if="{{birthday && daysUntil > 0}}">
          距离生日还有 {{daysUntil}} 天
        </text>
        <text class="birthday-desc" wx:if="{{!birthday}}">
          设置生日后，生日当天可领取专属礼品
        </text>

        <view class="gift-preview">
          <view class="mystery-gift-header">
            <t-icon name="gift" size="32rpx" color="#7C9A92" />
            <text class="preview-title">神秘礼品</text>
          </view>
          <view class="mystery-gift-box">
            <view class="mystery-gift-icon">
              <t-icon name="lock-on" size="48rpx" color="#FFFFFF" />
            </view>
            <view class="mystery-gift-content">
              <text class="mystery-gift-name">???</text>
              <text class="mystery-gift-hint">生日当天揭晓，敬请期待</text>
            </view>
          </view>
          <view class="mystery-gift-decorations">
            <view class="deco-dot"></view>
            <view class="deco-dot"></view>
            <view class="deco-dot"></view>
          </view>
        </view>
        
        <t-button 
          wx:if="{{!birthday && !showDatePicker}}"
          theme="primary" 
          class="btn-gold-outline set-btn" 
          size="large"
          bindtap="openDatePicker"
        >
          设置生日
        </t-button>
        
        <!-- 生日日期选择器（内联模式） -->
        <view wx:if="{{showDatePicker}}" class="date-picker-section">
          <t-date-time-picker
            mode="date"
            title="选择日期"
            format="YYYY-MM-DD"
            value="{{pickerValue}}"
            start="1960-01-01"
            end="{{currentDate}}"
            use-popup="{{false}}"
            confirm-btn="确认"
            cancel-btn="取消"
            bind:confirm="onDateConfirm"
            bind:cancel="onDateCancel"
          />
        </view>
      </view>
    </block>
  </view>
  
  <!-- 历史记录 -->
  <view class="history-section" wx:if="{{giftHistory.length > 0}}">
    <view class="history-title">领取记录</view>
    <view class="history-list">
      <view class="history-item" wx:for="{{giftHistory}}" wx:key="id">
        <view class="history-info">
          <text class="history-name">{{item.gift_name}}</text>
          <text class="history-year">{{item.year}}年</text>
        </view>
        <view class="history-status {{item.status === 1 ? 'claimed' : ''}}">
          {{item.status === 1 ? '已领取' : '未领取'}}
        </view>
      </view>
    </view>
  </view>
  
  <!-- 底部安全区域 -->
  <view class="safe-area-bottom"></view>
</view>
