/* ============================================
   我的页面样式
   ============================================ */

/* 用户卡片 */
.user-card {
  position: relative;
  margin: 20rpx 30rpx 30rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #FFFFFF, #F5F6F8);
  border: 1rpx solid rgba(124, 154, 146, 0.15);
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(135deg, rgba(124, 154, 146, 0.3), rgba(138, 43, 226, 0.2));
}

.user-content {
  position: relative;
  padding: 40rpx 30rpx 30rpx;
}

/* 登录区域 */
.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.login-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border: 4rpx solid rgba(124, 154, 146, 0.2);
}

.login-tip {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 30rpx;
}

.login-btn {
  width: 400rpx;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(124, 154, 146, 0.5);
  margin-right: 24rpx;
  background: #FFFFFF;
}

.user-avatar.default-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.user-detail {
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1D23;
}

.user-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.shareholder-tag {
  background: rgba(124, 154, 146, 0.2);
  color: #7C9A92;
  border: 1rpx solid rgba(124, 154, 146, 0.4);
}

.member-tag {
  background: rgba(0, 0, 0, 0.06);
  color: #6B7280;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.user-id {
  font-size: 24rpx;
  color: #6B7280;
}

/* 股东数据 */
.shareholder-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(124, 154, 146, 0.1);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #7C9A92;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #6B7280;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.06);
}

/* 菜单区域 */
.menu-section {
  padding: 0 30rpx;
}

.menu-group {
  margin-bottom: 30rpx;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #7C9A92;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #7C9A92;
}

/* 成为股东卡片 */
.become-shareholder-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
}

.become-shareholder-card:active {
  border-color: rgba(124, 154, 146, 0.5);
}

.bsc-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.bsc-text {
  display: flex;
  flex-direction: column;
}

.bsc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D23;
  margin-bottom: 8rpx;
}

.bsc-desc {
  font-size: 22rpx;
  color: #6B7280;
}

/* 菜单单元格 */
.menu-cell {
  background: #FFFFFF !important;
}

.menu-cell-title {
  color: #1A1D23 !important;
  font-size: 28rpx !important;
}

.cell-note {
  color: #6B7280;
  font-size: 26rpx;
}

/* 退出登录 */
.logout-section {
  margin: 40rpx 0 60rpx;
}

.logout-btn {
  border-color: rgba(255, 77, 79, 0.5) !important;
  color: #ff4d4f !important;
}
