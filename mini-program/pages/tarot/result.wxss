/* ============================================
   占卜结果页样式
   ============================================ */

/* 结果头部 */
.result-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 40rpx 30rpx 20rpx;
}

.result-stars {
  font-size: 24rpx;
  color: #7C9A92;
  letter-spacing: 8rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #7C9A92;
  letter-spacing: 8rpx;
}

/* 牌面展示 */
.card-result-section {
  padding: 20rpx 40rpx;
}

.card-display {
  display: flex;
  justify-content: center;
  position: relative;
  margin-bottom: 40rpx;
}

.card-display.reversed .card-image {
  transform: rotate(180deg);
}

.card-image {
  width: 360rpx;
  height: 520rpx;
  border-radius: 24rpx;
  object-fit: cover;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  border: 4rpx solid rgba(124, 154, 146, 0.3);
}

.card-position-badge {
  position: absolute;
  top: 20rpx;
  right: 60rpx;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.badge-upright {
  background: rgba(82, 196, 26, 0.9);
  color: #fff;
}

.badge-reversed {
  background: rgba(255, 77, 79, 0.9);
  color: #fff;
}

/* 牌信息 */
.card-info {
  text-align: center;
  margin-bottom: 40rpx;
}

.card-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #7C9A92;
  display: block;
  margin-bottom: 8rpx;
}

.card-enname {
  font-size: 26rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 16rpx;
}

.card-keywords {
  font-size: 26rpx;
  color: #9CA3AF;
  display: block;
  margin-bottom: 30rpx;
  padding: 0 60rpx;
}

.card-meaning {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 0 20rpx;
  border: 1rpx solid rgba(124, 154, 146, 0.1);
}

.meaning-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #7C9A92;
  display: block;
  margin-bottom: 12rpx;
}

.meaning-text {
  font-size: 28rpx;
  color: #9CA3AF;
  line-height: 1.8;
  display: block;
}

/* 推荐区域 */
.recommend-section {
  padding: 0 30rpx 30rpx;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-wrapper .title-line {
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #7C9A92, #5F8578);
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.section-title-wrapper text {
  font-size: 30rpx;
  font-weight: 600;
  color: #7C9A92;
}

.recommend-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(124, 154, 146, 0.15);
}

.recommend-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.recommend-content {
  padding: 24rpx;
}

.recommend-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.recommend-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1D23;
  display: block;
}

.recommend-enname {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
  display: block;
}

.recommend-price {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.price-symbol {
  font-size: 24rpx;
  color: #7C9A92;
  font-weight: 600;
}

.price-value {
  font-size: 36rpx;
  color: #7C9A92;
  font-weight: 700;
}

.recommend-reason {
  display: flex;
  gap: 12rpx;
  background: rgba(124, 154, 146, 0.05);
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.recommend-reason text {
  font-size: 26rpx;
  color: #9CA3AF;
  line-height: 1.6;
  flex: 1;
}

.recommend-meta {
  display: flex;
  gap: 12rpx;
}

.meta-tag {
  font-size: 22rpx;
  color: #7C9A92;
  background: rgba(124, 154, 146, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
}

/* 无推荐 */
.no-recommend {
  padding: 60rpx 40rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

/* 操作按钮 */
.action-buttons {
  padding: 20rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
}
