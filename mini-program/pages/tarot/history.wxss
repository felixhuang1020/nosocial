/* ============================================
   占卜历史页样式
   ============================================ */

.page-header {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #7C9A92;
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #6B7280;
}

/* 历史列表 */
.history-list {
  padding: 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(124, 154, 146, 0.1);
  transition: all 0.3s ease;
}

.history-card:active {
  transform: scale(0.98);
  border-color: rgba(124, 154, 146, 0.3);
}

.card-display {
  position: relative;
  width: 140rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.card-display.reversed .card-image {
  transform: rotate(180deg);
}

.card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-placeholder {
  width: 100%;
  height: 100%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.card-no {
  font-size: 24rpx;
  color: #7C9A92;
  font-weight: 600;
}

.card-position-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
}

.badge-upright {
  background: rgba(82, 196, 26, 0.9);
  color: #fff;
}

.badge-reversed {
  background: rgba(255, 77, 79, 0.9);
  color: #fff;
}

.history-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #7C9A92;
}

.history-date {
  font-size: 22rpx;
  color: #6B7280;
  flex-shrink: 0;
}

.card-keywords {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend-mini {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(124, 154, 146, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
}

.recommend-mini text {
  font-size: 22rpx;
  color: #7C9A92;
}

/* 加载更多 */
.loading-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
}

.loading-text {
  color: #6B7280 !important;
  font-size: 24rpx !important;
}

.no-more {
  padding: 20rpx 60rpx 40rpx;
}

.divider-text {
  color: #6B7280 !important;
  font-size: 22rpx !important;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 60rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #6B7280;
  margin-top: 20rpx;
  margin-bottom: 30rpx;
}

.empty-btn {
  width: 300rpx;
}
