/* ============================================
   塔罗占卜页样式
   ============================================ */

.page-header {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #7C9A92;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #6B7280;
}

/* 问题输入区 */
.question-section {
  padding: 40rpx 40rpx;
}

.question-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(124, 154, 146, 0.15);
  margin-bottom: 40rpx;
}

.question-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1D23;
  margin: 20rpx 0 30rpx;
}

.question-input {
  width: 100%;
  height: 80rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 0 24rpx;
  color: #1A1D23;
  font-size: 28rpx;
  text-align: center;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
}

.input-placeholder {
  color: #6B7280;
  font-size: 26rpx;
}

.question-hint {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 20rpx;
}

.start-btn {
  width: 100%;
}

/* 洗牌动画区 */
.shuffle-section {
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.shuffle-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.deck-wrapper {
  position: relative;
  width: 280rpx;
  height: 400rpx;
  margin-bottom: 40rpx;
}

.card-back {
  position: absolute;
  width: 260rpx;
  height: 380rpx;
  background: linear-gradient(145deg, #7C9A92, #5F8578);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  left: 10rpx;
  top: 10rpx;
}

.card-back.shuffling {
  animation: shuffleCard 0.8s ease-in-out infinite alternate;
}

@keyframes shuffleCard {
  0% {
    transform: translateX(0) rotate(0deg);
  }
  100% {
    transform: translateX(var(--shuffle-x, 30rpx)) rotate(var(--shuffle-rotate, 5deg));
  }
}

.card-pattern {
  width: 80%;
  height: 80%;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pattern-star {
  font-size: 60rpx;
  color: rgba(255, 255, 255, 0.7);
}

.shuffle-text {
  font-size: 32rpx;
  color: #7C9A92;
  font-weight: 600;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.draw-btn {
  width: 400rpx;
  transition: all 0.3s ease;
}

.draw-btn.disabled {
  opacity: 0.5;
}

.draw-btn.pulse {
  animation: pulse-gold 1.5s ease-in-out infinite;
}

@keyframes pulse-gold {
  0%, 100% { box-shadow: 0 0 10rpx rgba(124, 154, 146, 0.3); }
  50% { box-shadow: 0 0 40rpx rgba(124, 154, 146, 0.6); }
}

/* 抽牌区 */
.draw-section {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.draw-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.card-slot {
  width: 320rpx;
  height: 480rpx;
  perspective: 1000rpx;
  margin-bottom: 40rpx;
}

.card-reveal {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 1s ease-in-out;
}

.card-reveal.revealed {
  transform: rotateY(180deg);
}

.card-reveal.reversed {
  transform: rotateY(180deg) rotateZ(180deg);
}

.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.card-back-face {
  background: linear-gradient(145deg, #7C9A92, #5F8578);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.2);
}

.card-pattern-large {
  width: 85%;
  height: 85%;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.pattern-star-large {
  font-size: 80rpx;
  color: rgba(255, 255, 255, 0.6);
}

.pattern-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 600;
  letter-spacing: 4rpx;
}

.card-front-face {
  background: #FFFFFF;
  transform: rotateY(180deg);
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 4rpx solid rgba(124, 154, 146, 0.3);
}

.card-image {
  width: 100%;
  height: 380rpx;
  object-fit: cover;
}

.card-info-overlay {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(124, 154, 146, 0.9);
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.card-position {
  font-size: 24rpx;
  color: #F5F6F8;
  font-weight: 700;
}

.card-meaning {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  transform: translateY(30rpx);
  transition: all 0.6s ease 0.5s;
}

.card-meaning.show {
  opacity: 1;
  transform: translateY(0);
}

.card-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #7C9A92;
  margin-bottom: 8rpx;
}

.card-enname {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 16rpx;
}

.card-keyword {
  font-size: 26rpx;
  color: #9CA3AF;
}

.result-btn {
  width: 400rpx;
}

/* 历史记录入口 */
.history-entry {
  position: fixed;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
}

.history-entry text {
  font-size: 26rpx;
  color: #6B7280;
}

.history-entry:active {
  border-color: rgba(124, 154, 146, 0.5);
}
