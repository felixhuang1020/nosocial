/* ============================================
   优惠券列表页样式
   ============================================ */

.page-header {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #7C9A92;
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #6B7280;
}

/* 优惠券列表 */
.coupon-list {
  padding: 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.coupon-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
  position: relative;
}

.coupon-card.disabled {
  opacity: 0.6;
  border-color: rgba(0, 0, 0, 0.06);
}

.coupon-left {
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, rgba(124, 154, 146, 0.15), rgba(124, 154, 146, 0.05));
}

.coupon-amount {
  display: flex;
  align-items: baseline;
}

.amount-symbol {
  font-size: 28rpx;
  color: #7C9A92;
  font-weight: 600;
}

.amount-value {
  font-size: 56rpx;
  color: #7C9A92;
  font-weight: 700;
}

.coupon-condition {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 8rpx;
  text-align: center;
}

/* 分割线 */
.coupon-divider {
  width: 20rpx;
  position: relative;
  background: #FFFFFF;
}

.divider-line {
  position: absolute;
  left: 50%;
  top: 20rpx;
  bottom: 20rpx;
  width: 2rpx;
  border-left: 2rpx dashed rgba(0, 0, 0, 0.08);
  transform: translateX(-50%);
}

.divider-dot {
  position: absolute;
  left: 50%;
  width: 20rpx;
  height: 20rpx;
  background: #F5F6F8;
  border-radius: 50%;
  transform: translateX(-50%);
}

.divider-dot.top {
  top: -10rpx;
}

.divider-dot.bottom {
  bottom: -10rpx;
}

/* 右侧 */
.coupon-right {
  flex: 1;
  display: flex;
  padding: 24rpx 20rpx;
  min-width: 0;
}

.coupon-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1D23;
  margin-bottom: 8rpx;
}

.coupon-type {
  font-size: 22rpx;
  color: #7C9A92;
  margin-bottom: 8rpx;
}

.coupon-valid {
  font-size: 20rpx;
  color: #6B7280;
}

.coupon-status {
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

.status-badge.unused {
  background: rgba(82, 196, 26, 0.2);
  color: #52c41a;
}

.status-badge.used {
  background: rgba(0, 0, 0, 0.06);
  color: #6B7280;
}

.status-badge.expired {
  background: rgba(255, 77, 79, 0.2);
  color: #ff4d4f;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 60rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #6B7280;
  margin-top: 20rpx;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #6B7280;
  text-align: center;
}
