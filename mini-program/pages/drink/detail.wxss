/* ============================================
   酒水详情页样式
   ============================================ */

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

/* 顶部大图 */
.drink-hero {
  position: relative;
  width: 100%;
  height: 500rpx;
}

.drink-hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.drink-hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
}

.drink-badges {
  display: flex;
  gap: 12rpx;
}

.hero-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-badge.recommend {
  background: rgba(255, 77, 79, 0.9);
  color: #fff;
}

.hero-badge.free {
  background: linear-gradient(135deg, #7C9A92, #5F8578);
  color: #F5F6F8;
}

/* 详情卡片 */
.drink-detail-card {
  margin: -40rpx 0 0;
  background: #F5F6F8;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 30rpx;
  position: relative;
  z-index: 1;
}

.drink-name-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.drink-name-wrapper {
  flex: 1;
  min-width: 0;
}

.drink-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1D23;
  display: block;
  margin-bottom: 8rpx;
}

.drink-enname {
  font-size: 24rpx;
  color: #6B7280;
}

.drink-price {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.price-symbol {
  font-size: 28rpx;
  color: #7C9A92;
  font-weight: 600;
}

.price-value {
  font-size: 48rpx;
  color: #7C9A92;
  font-weight: 700;
}

/* 元数据 */
.drink-meta-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
}

.meta-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(124, 154, 146, 0.1);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
}

.meta-chip text {
  font-size: 24rpx;
  color: #7C9A92;
}

/* 区块标签 */
.drink-section {
  margin-bottom: 30rpx;
}

.section-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-line {
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #7C9A92, #5F8578);
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.section-label text {
  font-size: 30rpx;
  font-weight: 600;
  color: #7C9A92;
}

.drink-description {
  font-size: 28rpx;
  color: #9CA3AF;
  line-height: 1.8;
  padding-left: 20rpx;
}

/* 配料 */
.ingredients-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-left: 20rpx;
}

.ingredient-tag {
  background: rgba(124, 154, 146, 0.1);
  color: #7C9A92;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(124, 154, 146, 0.3);
}

/* 塔罗关联 */
.tarot-card-mini {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-left: 20rpx;
  border: 1rpx solid rgba(124, 154, 146, 0.1);
}

.tarot-mini-image {
  width: 100rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  object-fit: cover;
}

.tarot-mini-info {
  flex: 1;
}

.tarot-mini-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #7C9A92;
  display: block;
  margin-bottom: 8rpx;
}

.tarot-mini-meaning {
  font-size: 24rpx;
  color: #6B7280;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(245, 246, 248, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(124, 154, 146, 0.15);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}

.bottom-price {
  display: flex;
  flex-direction: column;
}

.bottom-price.free-text .bottom-value {
  color: #52c41a;
}

.bottom-label {
  font-size: 22rpx;
  color: #6B7280;
}

.bottom-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #7C9A92;
}

.order-btn {
  width: 280rpx;
}
