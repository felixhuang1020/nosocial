/* ============================================
   首页样式
   ============================================ */

/* 轮播图 */
.banner-section {
  padding: 20rpx 30rpx 10rpx;
}

.banner-swiper {
  border-radius: 20rpx;
  overflow: hidden;
}

/* 功能入口 */
.features-section {
  padding: 20rpx 30rpx;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.feature-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx 24rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.feature-card:active {
  transform: scale(0.96);
  border-color: rgba(124, 154, 146, 0.4);
}

.feature-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.gold-gradient {
  background: linear-gradient(135deg, #7C9A92, #5F8578);
}

.rose-gradient {
  background: linear-gradient(135deg, #FF6B6B, #EE5A5A);
}

.purple-gradient {
  background: linear-gradient(135deg, #A855F7, #9333EA);
}

.blue-gradient {
  background: linear-gradient(135deg, #3B82F6, #2563EB);
}

.feature-content {
  flex: 1;
  min-width: 0;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D23;
  display: block;
  margin-bottom: 6rpx;
}

.feature-subtitle {
  font-size: 22rpx;
  color: #6B7280;
}

.feature-arrow {
  flex-shrink: 0;
}

/* 今日推荐 */
.recommend-section {
  padding: 0 0 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
}

.title-line {
  width: 6rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #7C9A92, #5F8578);
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #7C9A92;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #7C9A92;
}

.recommend-card {
  margin: 0 30rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  height: 480rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.recommend-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.recommend-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(245, 246, 248, 0.95));
  padding: 60rpx 30rpx 30rpx;
}

.recommend-badge {
  position: absolute;
  top: -180rpx;
  right: 20rpx;
  background: rgba(255, 77, 79, 0.9);
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.recommend-badge text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.recommend-info {
  display: flex;
  flex-direction: column;
}

.recommend-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1D23;
  margin-bottom: 8rpx;
}

.recommend-enname {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 12rpx;
}

.recommend-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.recommend-alcohol,
.recommend-volume {
  font-size: 22rpx;
  color: #6B7280;
}

.recommend-dot {
  font-size: 22rpx;
  color: #6B7280;
}

.recommend-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recommend-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #7C9A92;
}

.price-symbol {
  font-size: 28rpx;
}

.recommend-btn {
  background: linear-gradient(135deg, #7C9A92, #5F8578);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 30rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 店铺信息 */
.shop-section {
  padding: 0 0 30rpx;
}

.shop-card {
  margin: 0 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.shop-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #7C9A92;
  text-align: center;
  margin-bottom: 8rpx;
}

.shop-desc {
  font-size: 24rpx;
  color: #6B7280;
  text-align: center;
  margin-bottom: 30rpx;
}

.shop-info-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.shop-info-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E5E7EB;
}

.shop-info-item:last-child {
  border-bottom: none;
}

.info-icon {
  width: 64rpx;
  height: 64rpx;
  background: rgba(124, 154, 146, 0.1);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.info-label {
  font-size: 22rpx;
  color: #6B7280;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 28rpx;
  color: #1A1D23;
}

.copy-btn {
  font-size: 22rpx;
  color: #7C9A92;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(124, 154, 146, 0.3);
  border-radius: 12rpx;
}

.copy-btn:active {
  background: rgba(124, 154, 146, 0.1);
}

.recommend-empty {
  padding: 100rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
