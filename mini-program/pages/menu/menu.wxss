/* ============================================
   酒水单页样式
   ============================================ */

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
}

.search-input-wrapper {
  background: #FFFFFF;
  border-radius: 40rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-placeholder {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #9CA3AF;
}

/* 分类标签 */
.category-section {
  padding: 10rpx 0 20rpx;
}

.category-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 28rpx;
  margin: 0 8rpx;
  position: relative;
}

.category-name {
  font-size: 28rpx;
  color: #6B7280;
  transition: all 0.3s ease;
}

.category-item.active .category-name {
  color: #7C9A92;
  font-weight: 600;
  font-size: 30rpx;
}

.category-indicator {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #7C9A92, #5F8578);
  border-radius: 2rpx;
}

/* 酒水列表 */
.drink-list {
  padding: 0 30rpx;
}

.drink-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.drink-card:active {
  transform: scale(0.98);
  border-color: rgba(124, 154, 146, 0.3);
}

.drink-image-wrapper {
  width: 220rpx;
  height: 220rpx;
  position: relative;
  flex-shrink: 0;
}

.drink-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.drink-badges {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.badge-recommend {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 77, 79, 0.9);
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}

.badge-recommend text {
  font-size: 18rpx;
  color: #fff;
  font-weight: 600;
}

.badge-free {
  background: linear-gradient(135deg, #7C9A92, #5F8578);
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}

.badge-free text {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.drink-info {
  flex: 1;
  padding: 24rpx 24rpx 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.drink-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.drink-name-wrapper {
  flex: 1;
  min-width: 0;
}

.drink-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D23;
  display: block;
}

.drink-enname {
  font-size: 20rpx;
  color: #6B7280;
  margin-top: 4rpx;
  display: block;
}

.drink-price {
  display: flex;
  align-items: baseline;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.price-symbol {
  font-size: 24rpx;
  color: #7C9A92;
  font-weight: 600;
}

.price-value {
  font-size: 36rpx;
  color: #7C9A92;
  font-weight: 700;
}

.drink-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #6B7280;
}

.meta-dot {
  font-size: 22rpx;
  color: #6B7280;
}

.drink-desc {
  font-size: 22rpx;
  color: #9CA3AF;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.drink-ingredients {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.ingredient-tag {
  font-size: 18rpx;
  color: #7C9A92;
  background: rgba(124, 154, 146, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(124, 154, 146, 0.2);
}

/* 加载状态 */
.loading-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
}

.loading-text {
  color: #6B7280 !important;
  font-size: 24rpx !important;
}

.no-more {
  padding: 20rpx 60rpx 40rpx;
}

.divider-text {
  color: #6B7280 !important;
  font-size: 22rpx !important;
}

/* 空状态 */
.empty-state {
  padding: 100rpx 60rpx;
}

.empty-desc {
  color: #6B7280 !important;
  font-size: 28rpx !important;
}
