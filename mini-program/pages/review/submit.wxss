/* ============================================
   点评提交页样式
   ============================================ */

.page-header {
  padding: 40rpx 30rpx 30rpx;
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #7C9A92;
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #6B7280;
}

/* 上传区域 */
.upload-section {
  padding: 0 30rpx 30rpx;
}

.upload-label {
  font-size: 28rpx;
  color: #1A1D23;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.required {
  color: #ff4d4f;
}

.upload-area {
  width: 100%;
  height: 360rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(124, 154, 146, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.upload-hint {
  font-size: 28rpx;
  color: #9CA3AF;
}

.upload-tip {
  font-size: 22rpx;
  color: #6B7280;
}

.upload-preview {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  border: 2rpx solid rgba(124, 154, 146, 0.3);
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.preview-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.upload-preview:active .preview-mask {
  opacity: 1;
}

.preview-mask text {
  font-size: 24rpx;
  color: #fff;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F5F6F8;
}

.grid-image {
  width: 100%;
  height: 100%;
}

.image-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.error-retry {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.error-text {
  font-size: 20rpx;
  color: #ff4d4f;
  margin-top: 4rpx;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image {
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(124, 154, 146, 0.3);
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 内容区域 */
.content-section {
  padding: 0 30rpx 40rpx;
}

.content-label {
  font-size: 28rpx;
  color: #1A1D23;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.review-textarea {
  background: #FFFFFF !important;
  border-radius: 16rpx !important;
  border: 1rpx solid rgba(124, 154, 146, 0.1) !important;
  color: #1A1D23 !important;
  font-size: 28rpx !important;
}

.textarea-placeholder {
  color: #6B7280 !important;
}

/* 提交区域 */
.submit-section {
  padding: 0 30rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.submit-btn {
  width: 100%;
  margin-bottom: 20rpx;
}

.submit-note {
  font-size: 24rpx;
  color: #6B7280;
}
