/* ============================================
   股东申请页样式
   ============================================ */

.page-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx 30rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #7C9A92;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #6B7280;
}

/* 权益卡片 */
.benefits-section {
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.benefit-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(124, 154, 146, 0.1);
}

.benefit-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.gold-gradient {
  background: linear-gradient(135deg, #7C9A92, #5F8578);
}

.rose-gradient {
  background: linear-gradient(135deg, #FF6B6B, #EE5A5A);
}

.purple-gradient {
  background: linear-gradient(135deg, #A855F7, #9333EA);
}

.benefit-content {
  flex: 1;
  min-width: 0;
}

.benefit-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D23;
  display: block;
  margin-bottom: 8rpx;
}

.benefit-desc {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
}

/* 费用区域 */
.fee-section {
  padding: 30rpx;
}

.fee-card {
  background: linear-gradient(135deg, rgba(124, 154, 146, 0.15), rgba(124, 154, 146, 0.05));
  border: 2rpx solid rgba(124, 154, 146, 0.3);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: pulse-gold 2s ease-in-out infinite;
}

.fee-label {
  font-size: 28rpx;
  color: #9CA3AF;
  margin-bottom: 16rpx;
}

.fee-price {
  display: flex;
  align-items: baseline;
}

.fee-symbol {
  font-size: 40rpx;
  color: #7C9A92;
  font-weight: 600;
}

.fee-value {
  font-size: 72rpx;
  color: #7C9A92;
  font-weight: 700;
}

.fee-note {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 12rpx;
}

/* 规则区域 */
.rules-section {
  padding: 0 30rpx 40rpx;
}

.rules-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #7C9A92;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #7C9A92;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
}

.rule-dot {
  width: 12rpx;
  height: 12rpx;
  background: #7C9A92;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.rule-text {
  font-size: 26rpx;
  color: #9CA3AF;
  line-height: 1.6;
  flex: 1;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(245, 246, 248, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(124, 154, 146, 0.15);
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.pay-btn {
  width: 100%;
}
