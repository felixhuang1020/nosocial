/* ============================================
   NoSocial 酒吧小程序 - 全局样式
   主题色：淡雅简约风格
   主色调：#7C9A92 (莫兰迪绿)
   背景色：#F5F6F8 (浅灰白)
   ============================================ */

page {
  --nosocial-gold: #7C9A92;
  --nosocial-gold-light: #8EAEA6;
  --nosocial-gold-dark: #5F8578;
  --nosocial-black: #F5F6F8;
  --nosocial-black-light: #FFFFFF;
  --nosocial-black-lighter: #F9FAFB;
  --nosocial-gray: #6B7280;
  --nosocial-gray-light: #9CA3AF;
  --nosocial-white: #1A1D23;
  --nosocial-red: #ff4d4f;
  --nosocial-green: #52c41a;

  /* TDesign 主题变量覆盖 - 淡雅简约风格 */
  --td-brand-color: #7C9A92;
  --td-brand-color-light: rgba(124, 154, 146, 0.12);
  --td-primary-color-7: #7C9A92;
  --td-primary-color-1: #E8F0ED;
  --td-bg-color-page: #F5F6F8;
  --td-bg-color-container: #FFFFFF;
  --td-bg-color-secondarycontainer: #F9FAFB;
  --td-text-color-primary: #1A1D23;
  --td-text-color-secondary: #6B7280;
  --td-text-color-placeholder: #9CA3AF;
  --td-component-border: #E5E7EB;
  --td-border-color: #E5E7EB;

  background-color: var(--nosocial-black);
  color: var(--nosocial-white);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 重置默认样式 */
view, text, image, swiper, swiper-item {
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  background-color: var(--nosocial-black);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.container-safe {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.container-safe {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 页面标题 */
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--nosocial-gold);
  text-align: center;
  padding: 30rpx 0;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--nosocial-gray);
  text-align: center;
  margin-top: -20rpx;
  margin-bottom: 30rpx;
}

/* 莫兰迪绿分割线 */
.gold-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--nosocial-gold), transparent);
  margin: 30rpx 40rpx;
}

/* 卡片样式 */
.card {
  background: var(--nosocial-black-light);
  border-radius: 20rpx;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-gold {
  background: linear-gradient(145deg, rgba(124, 154, 146, 0.12), rgba(124, 154, 146, 0.04));
  border: 1rpx solid rgba(124, 154, 146, 0.3);
}

/* 功能入口网格 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 30rpx;
  margin: 30rpx 0;
}

.feature-item {
  background: var(--nosocial-black-light);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.feature-item:active {
  transform: scale(0.96);
  border-color: var(--nosocial-gold);
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--nosocial-gold), var(--nosocial-gold-dark));
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon text {
  font-size: 40rpx;
  color: #FFFFFF;
}

.feature-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--nosocial-white);
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: var(--nosocial-gray);
}

/* 莫兰迪绿按钮 */
.btn-gold {
  background: linear-gradient(135deg, var(--nosocial-gold), var(--nosocial-gold-dark)) !important;
  color: #FFFFFF !important;
  border: none !important;
  font-weight: 600 !important;
  border-radius: 50rpx !important;
}

.btn-gold-outline {
  background: transparent !important;
  color: var(--nosocial-gold) !important;
  border: 2rpx solid var(--nosocial-gold) !important;
  font-weight: 600 !important;
  border-radius: 50rpx !important;
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  margin: 40rpx 0 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--nosocial-gold);
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, var(--nosocial-gold), var(--nosocial-gold-dark));
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--nosocial-gray);
  display: flex;
  align-items: center;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--nosocial-gray);
  text-align: center;
}

/* 标签 */
.tag-gold {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  background: rgba(124, 154, 146, 0.12);
  color: var(--nosocial-gold);
  font-size: 22rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(124, 154, 146, 0.3);
}

/* 加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(245, 246, 248, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes pulse-gold {
  0%, 100% { box-shadow: 0 0 10rpx rgba(124, 154, 146, 0.3); }
  50% { box-shadow: 0 0 30rpx rgba(124, 154, 146, 0.5); }
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.animate-fade-in {
  animation: fadeIn 0.5s ease-out;
}

.animate-pulse-gold {
  animation: pulse-gold 2s ease-in-out infinite;
}

/* 滚动条隐藏 */
::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
  background: transparent;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 价格样式 */
.price {
  color: var(--nosocial-gold);
  font-weight: 700;
}

.price::before {
  content: '¥';
  font-size: 0.75em;
  margin-right: 4rpx;
}

/* 状态标签 */
.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.status-pending {
  background: rgba(255, 193, 7, 0.2);
  color: #ffc107;
}

.status-success {
  background: rgba(82, 196, 26, 0.2);
  color: #52c41a;
}

.status-error {
  background: rgba(255, 77, 79, 0.2);
  color: #ff4d4f;
}
