# NoSocial 生产环境 Caddy 配置
# ============================================================
# 部署前请设置环境变量 DOMAIN（例：export DOMAIN=api.example.com）并重启 Caddy
# Caddy 将自动向 Let's Encrypt 申请并续期证书（需域名解析到本机公网 IP，80/443 开放）
# ============================================================

{
    # 如用于 Let's Encrypt 声明 / 业务告警
    email admin@{$DOMAIN}
}

# 生产：必须使用 HTTPS（微信支付回调强制要求）
{$DOMAIN} {
    # 自动 HTTPS（省略即默认开启）
    encode zstd gzip

    # 前端静态文件托管
    root * /usr/share/caddy/html
    try_files {path} /index.html
    file_server

    # 反向代理 API 请求到后端服务
    # Linux Docker 访问宿主机默认网桥地址为 172.17.0.1
    # 若后端也在 Docker Compose 中，请改为服务名（如 backend:8080）
    @api {
        path /api/*
    }
    reverse_proxy @api 172.17.0.1:8080 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # 访问日志
    log {
        output file /data/access.log
        format json
    }

    # 响应头安全加固
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer-when-downgrade
        -Server
    }
}

# ============================================================
# 开发 / 内网部署（无域名）回退配置，仅供调试使用：
# 将下方注释块去掉注释并注释掉上方生产块，同时在全局块加上 auto_https off
# ============================================================
